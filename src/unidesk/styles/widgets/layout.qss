/* Η σειρά έχει σημασία: οι κανόνες "descendant" (με *) πρέπει να
   μένουν πρώτοι. Έχουν ίδια ειδικότητα με τους κανόνες ρόλων, και
   αν μπουν μετά, κερδίζουν αυτοί και βάφουν λάθος παιδιά (hero,
   divider, footer, scroll content). */
QWidget[layout="transparent"] * { background: transparent; }
QScrollArea[layout="scroll"] * { background: #1a1226; }
QMainWindow[layout="window"] { background-color: #1a1226; }
QWidget[layout="hero"] { background: #211a2c; }
QWidget[layout="bar"] { background: #110d1a; }
QWidget[layout="transparent"] { background: transparent; }
QScrollArea[layout="scroll"] { background: #1a1226; }
QFrame[layout="divider"] { background-color: #2d1f3d; border: none; }
