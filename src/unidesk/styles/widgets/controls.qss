QPushButton[button="back"] { background: transparent; border: none; color: #a6adc8; font-size: 12px; text-align: left; }
QPushButton[button="footer-link"] { background: transparent; border: none; color: #8b5897; font-size: 11px; }
QPushButton[button="link"] { background-color: #89b4fa; color: #1e1e2e; font-weight: bold; border: none; border-radius: 4px; padding: 5px 10px; font-size: 11px; }
QPushButton[button="link"]:hover { background-color: #b4befe; }
QPushButton[button="save"] { background-color: #89b4fa; color: #1e1e2e; font-weight: bold; border: none; border-radius: 4px; padding: 6px 12px; font-size: 12px; }
QPushButton[button="save"]:hover { background-color: #b4befe; }
QPushButton[button="configure"] { background-color: #2d1f3d; border: 1px solid #8b5897; border-radius: 5px; color: #cdd6f4; font-size: 11px; font-weight: bold; padding: 0 12px; }
